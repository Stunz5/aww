-- Fix 1: clickMouse pakai firesignal atau VIM, bukan :Fire()
local function clickMouse()
    pcall(function()
        if firesignal then
            firesignal(Mouse.Button1Down)
            task.wait(0.05)
            firesignal(Mouse.Button1Up)
        else
            VIM:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end
    end)
end

-- Fix 2: Klik tombol GUI Fishzar langsung via firesignal
local function fireButton(btn)
    if not btn then return end
    pcall(function()
        if firesignal then
            firesignal(btn.MouseButton1Click)
        elseif syn and syn.click_detector then
            -- fallback
        end
        -- Fallback universal: simulasi activate
        btn.Activated:Connect(function() end)
    end)
end

-- Fix 3: Cari tool rod (Fishzar pakai nama "Basic Rod")
local function getFishingTool()
    local keywords = {"rod", "fish", "reel", "pole", "basic"}
    -- Cari di karakter dulu
    for _, tool in pairs(Char:GetChildren()) do
        if tool:IsA("Tool") then
            local n = string.lower(tool.Name)
            for _, kw in pairs(keywords) do
                if string.find(n, kw) then return tool end
            end
        end
    end
    -- Cari di backpack
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local n = string.lower(tool.Name)
                for _, kw in pairs(keywords) do
                    if string.find(n, kw) then return tool end
                end
            end
        end
    end
    return nil
end

local function equipTool(tool)
    if not tool then return end
    Hum:EquipTool(tool)
    task.wait(0.4)
end

-- Fix 4: Deteksi minigame Fishzar
-- Fishzar pakai: BtnStart, BtnYes, BtnNo di dalam GUI
local function getFishzarButtons()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return nil, nil, nil end
    local btnStart, btnYes, btnNo

    for _, obj in pairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            local n = obj.Name
            if n == "BtnStart" then btnStart = obj end
            if n == "BtnYes"   then btnYes   = obj end
            if n == "BtnNo"    then btnNo     = obj end
        end
    end
    return btnStart, btnYes, btnNo
end

-- Cek apakah minigame aktif (BtnStart atau BtnYes visible)
local function isFishingActive()
    local btnStart, btnYes, _ = getFishzarButtons()
    if btnStart and btnStart.Visible then return true, "start" end
    if btnYes   and btnYes.Visible   then return true, "yes"   end
    return false, nil
end

-- Cek apakah sedang casting (menunggu gigitan)
local function isCasting()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return false end
    -- Kalau tidak ada minigame aktif tapi rod equipped = sedang casting
    local active, _ = isFishingActive()
    return not active
end

-- Auto sell: cari tombol sell di GUI
local function tryAutoSell()
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end

    -- Cari semua tombol dengan kata "sell", "jual" di nama atau text
    for _, obj in pairs(pg:GetDescendants()) do
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            local n = string.lower(obj.Name)
            local t = string.lower(obj.Text or "")
            if (string.find(n,"sell") or string.find(n,"jual") or
                string.find(t,"sell") or string.find(t,"jual")) and obj.Visible then
                fireButton(obj)
                task.wait(math.max(S.SellDelay, 0.3))
            end
        end
    end

    -- Coba remote sell
    local remoteNames = {"Sell","SellFish","SellAll","SellItem","sell","Jual"}
    for _, name in pairs(remoteNames) do
        local r = game:GetService("ReplicatedStorage"):FindFirstChild(name, true)
        if r then
            pcall(function()
                if r:IsA("RemoteEvent") then r:FireServer()
                elseif r:IsA("RemoteFunction") then r:InvokeServer() end
            end)
            task.wait(0.2)
        end
    end
end

-- ─────────────────────────────────
--   MAIN AUTO FISH LOOP
-- ─────────────────────────────────
local fishLoop  = false
local fishStats = {casts = 0, catches = 0, sold = 0}

local function StartAutoFish()
    fishLoop = true
    task.spawn(function()
        while fishLoop and S.AutoFish do
            local ok, err = pcall(function()
                task.wait(0.2) -- safety guard

                -- Pastikan rod di tangan
                local tool = getFishingTool()
                if not tool then
                    task.wait(1)
                    return
                end
                if not Char:FindFirstChild(tool.Name) then
                    equipTool(tool)
                    task.wait(0.5)
                end

                -- Cast: klik mouse untuk lempar
                if S.AutoCast and fishLoop then
                    clickMouse()
                    fishStats.casts += 1
                    task.wait(math.max(S.CastDelay, 0.2))
                end

                -- Tunggu minigame muncul (max 20 detik)
                local waited = 0
                while fishLoop and waited < 20 do
                    local active, phase = isFishingActive()
                    if active then break end
                    task.wait(0.3)
                    waited += 0.3
                end

                -- Handle minigame Fishzar
                local reelTime = 0
                while fishLoop and reelTime < 25 do
                    local active, phase = isFishingActive()
                    if not active then break end

                    if S.AutoReel then
                        local btnStart, btnYes, btnNo = getFishzarButtons()

                        -- Phase "BtnStart" = ikan gigit, klik untuk mulai reel
                        if phase == "start" and btnStart and btnStart.Visible then
                            fireButton(btnStart)
                            task.wait(0.1)

                        -- Phase "BtnYes/BtnNo" = pilihan, klik Yes
                        elseif phase == "yes" and btnYes and btnYes.Visible then
                            fireButton(btnYes)
                            task.wait(0.1)

                        else
                            -- Fallback: klik mouse biasa
                            clickMouse()
                        end
                    end

                    local d = math.max(S.ReelDelay, 0.1)
                    task.wait(d)
                    reelTime += d
                end

                -- Cek apakah dapat ikan
                local active, _ = isFishingActive()
                if not active and reelTime > 0 then
                    fishStats.catches += 1
                end

                task.wait(0.5)

                -- Auto sell
                if S.AutoSell and fishLoop then
                    tryAutoSell()
                    fishStats.sold += 1
                    task.wait(math.max(S.SellDelay, 0.5))
                end

                task.wait(0.3)
            end)

            if not ok then
                warn("[FishHub] Error: " .. tostring(err))
                task.wait(2)
            end
        end
    end)
end

local function StopAutoFish()
    fishLoop = false
end

