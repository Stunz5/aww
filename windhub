local function Toast(msg, col)
    local T = Instance.new("Frame")
    T.Size = UDim2.new(0, 280, 0, 44)
    T.Position = UDim2.new(0.5, -140, 1, 60)
    T.BackgroundColor3 = col or C.Surface
    T.BorderSizePixel = 0
    T.ZIndex = 20
    T.Parent = SG
    Round(T, 10)
    Stroke(T, col or C.Accent, 1)

    local TL = Instance.new("TextLabel")
    TL.Size = UDim2.new(1, -16, 1, 0)
    TL.Position = UDim2.new(0, 8, 0, 0)
    TL.BackgroundTransparency = 1
    TL.Text = msg
    TL.TextSize = 12
    TL.Font = Enum.Font.GothamBold
    TL.TextColor3 = C.Text
    TL.TextWrapped = true
    TL.ZIndex = 21
    TL.Parent = T

    Tween(T, {Position = UDim2.new(0.5, -140, 1, -58)}, TI.medium)
    task.delay(3, function()
        Tween(T, {Position = UDim2.new(0.5, -140, 1, 60), BackgroundTransparency = 1})
        task.delay(0.35, function() T:Destroy() end)
    end)
end

