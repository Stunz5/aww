    Val.Font = Enum.Font.GothamBold
    Val.TextColor3 = COLOR.Accent
    Val.TextXAlignment = Enum.TextXAlignment.Right
    Val.ZIndex = 8

    local TBG = Instance.new("Frame", Row)
    TBG.Size = UDim2.new(1, -24, 0, 4)
    TBG.Position = UDim2.new(0, 12, 0, 34)
    TBG.BackgroundColor3 = COLOR.Border
    TBG.BorderSizePixel = 0
    TBG.ZIndex = 8
    corner(TBG, 2)

    local Fill = Instance.new("Frame", TBG)
    Fill.BackgroundColor3 = COLOR.Accent
    Fill.BorderSizePixel = 0
    Fill.ZIndex = 9
    corner(Fill, 2)

    local Knob = Instance.new("Frame", TBG)
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.BackgroundColor3 = COLOR.White
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 10
    corner(Knob, 6)

    local function Update(v)
        local m = 10^dec
        v = math.clamp(math.round(v*m)/m, minV, maxV)
        S[key] = v; Val.Text = tostring(v)
        local pct = (v-minV)/(maxV-minV)
        Fill.Size = UDim2.new(pct,0,1,0)
        Knob.Position = UDim2.new(pct,-6,0.5,-6)
        ApplyPhysics()
    end
    Update(S[key])

    local drag = false
    Knob.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
            local rx = math.clamp(i.Position.X-TBG.AbsolutePosition.X, 0, TBG.AbsoluteSize.X)
            Update(minV+(maxV-minV)*(rx/TBG.AbsoluteSize.X))
        end
    end)
    TBG.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            local rx = math.clamp(i.Position.X-TBG.AbsolutePosition.X, 0, TBG.AbsoluteSize.X)
            Update(minV+(maxV-minV)*(rx/TBG.AbsoluteSize.X))
        end
    end)
end

local function Gap(h, scroll, OF)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1,0,0,h or 3)
    f.BackgroundTransparency = 1
    f.LayoutOrder = OF()
    f.Parent = scroll
end

local function ActionBtn(label, col, scroll, OF, cb)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 34)
    Btn.BackgroundColor3 = col or COLOR.Item
    Btn.BorderSizePixel = 0
    Btn.Text = label
    Btn.TextSize = 11
    Btn.Font = Enum.Font.GothamBold
    Btn.TextColor3 = COLOR.Text
    Btn.LayoutOrder = OF()
    Btn.ZIndex = 7
    Btn.Parent = scroll
    corner(Btn, 7)
    stroke(Btn, COLOR.Border)
    Btn.MouseEnter:Connect(function() tw(Btn, {BackgroundColor3=COLOR.Accent, TextColor3=COLOR.White}) end)
    Btn.MouseLeave:Connect(function() tw(Btn, {BackgroundColor3=col or COLOR.Item, TextColor3=COLOR.Text}) end)
    Btn.MouseButton1Click:Connect(function() if cb then cb() end end)
    return Btn
end

