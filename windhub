UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.RightShift then
        if isOpen then Close() else Open() end
    end
end)

-- ── Drag Window ──
local ds, sp, da = nil, nil, false
Header.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        da = true; ds = i.Position; sp = Win.Position
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then da = false end
end)
UserInputService.InputChanged:Connect(function(i)
    if da and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - ds
        Win.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
    end
end)

-- ── Drag Pill ──
local ps, pp, pd = nil, nil, false
Pill.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        pd = true; ps = i.Position; pp = Pill.Position
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then pd = false end
end)
UserInputService.InputChanged:Connect(function(i)
    if pd and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - ps
        Pill.Position = UDim2.new(pp.X.Scale, pp.X.Offset + d.X, pp.Y.Scale, pp.Y.Offset + d.Y)
    end
end)

print("[Wind Hub v3] Loaded! Tekan RightShift untuk menu.")
