-- Toggle row
local function Toggle(label, key, cb)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 40)
    Row.BackgroundColor3 = COLOR.Item
    Row.BorderSizePixel = 0
    Row.LayoutOrder = O()
    Row.ZIndex = 7
    Row.Parent = Scroll
    corner(Row, 7)
    stroke(Row, COLOR.Border)

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size = UDim2.new(1, -60, 1, 0)
    Lbl.Position = UDim2.new(0, 12, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = label
    Lbl.TextSize = 12
    Lbl.Font = Enum.Font.Gotham
    Lbl.TextColor3 = COLOR.Text
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.ZIndex = 8

    -- Track
    local Track = Instance.new("Frame", Row)
    Track.Size = UDim2.new(0, 36, 0, 18)
    Track.Position = UDim2.new(1, -46, 0.5, -9)
    Track.BorderSizePixel = 0
    Track.ZIndex = 8
    corner(Track, 9)

    local Knob = Instance.new("Frame", Track)
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.BackgroundColor3 = COLOR.White
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 9
    corner(Knob, 6)

    local function Refresh()
        if S[key] then
            tw(Track, {BackgroundColor3 = COLOR.Green})
            tw(Knob,  {Position = UDim2.new(0, 21, 0.5, -6)})
            tw(Lbl,   {TextColor3 = COLOR.White})
        else
            tw(Track, {BackgroundColor3 = COLOR.Border})
            tw(Knob,  {Position = UDim2.new(0, 3, 0.5, -6)})
            tw(Lbl,   {TextColor3 = COLOR.Text})
        end
    end
    Refresh()

    local Btn = Instance.new("TextButton", Row)
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text = ""
    Btn.ZIndex = 10

    Btn.MouseEnter:Connect(function() tw(Row, {BackgroundColor3 = Color3.fromRGB(32, 34, 42)}) end)
    Btn.MouseLeave:Connect(function() tw(Row, {BackgroundColor3 = COLOR.Item}) end)
    Btn.MouseButton1Click:Connect(function()
        S[key] = not S[key]
        Refresh()
        ApplyPhysics()
        if cb then cb(S[key]) end
    end)

    return Row
end

-- Slider row
local function Slider(label, key, minV, maxV, dec)
    dec = dec or 0
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 52)
    Row.BackgroundColor3 = COLOR.Item
    Row.BorderSizePixel = 0
    Row.LayoutOrder = O()
    Row.ZIndex = 7
    Row.Parent = Scroll
    corner(Row, 7)
    stroke(Row, COLOR.Border)

    local Lbl = Instance.new("TextLabel", Row)
    Lbl.Size = UDim2.new(0.6, 0, 0, 20)
    Lbl.Position = UDim2.new(0, 12, 0, 7)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = label
    Lbl.TextSize = 12
    Lbl.Font = Enum.Font.Gotham
    Lbl.TextColor3 = COLOR.Text
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.ZIndex = 8

    local Val = Instance.new("TextLabel", Row)
    Val.Size = UDim2.new(0.35, 0, 0, 20)
    Val.Position = UDim2.new(0.63, 0, 0, 7)
    Val.BackgroundTransparency = 1
    Val.TextSize = 12
    Val.Font = Enum.Font.GothamBold
    Val.TextColor3 = COLOR.Accent
    Val.TextXAlignment = Enum.TextXAlignment.Right
    Val.ZIndex = 8

    -- Track
    local TBG = Instance.new("Frame", Row)
    TBG.Size = UDim2.new(1, -24, 0, 4)
    TBG.Position = UDim2.new(0, 12, 0, 36)
    TBG.BackgroundColor3 = COLOR.Border
    TBG.BorderSizePixel = 0
    TBG.ZIndex = 8
    corner(TBG, 2)

    local Fill = Instance.new("Frame", TBG)
    Fill.BackgroundColor3 = COLOR.Accent
    Fill.BorderSizePixel = 0
    Fill.ZIndex = 9
    corner(Fill, 2)

    local Knob = Instance.new("Frame", TBG)
    Knob.Size = UDim2.new(0, 12, 0, 12)
    Knob.BackgroundColor3 = COLOR.White
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 10
    corner(Knob, 6)

    local function Update(v)
        local m = 10 ^ dec
        v = math.clamp(math.round(v * m) / m, minV, maxV)
        S[key] = v
        Val.Text = tostring(v)
        local pct = (v - minV) / (maxV - minV)
        Fill.Size = UDim2.new(pct, 0, 1, 0)
        Knob.Position = UDim2.new(pct, -6, 0.5, -6)
        ApplyPhysics()
    end
    Update(S[key])

    local drag = false
    Knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local rx = math.clamp(i.Position.X - TBG.AbsolutePosition.X, 0, TBG.AbsoluteSize.X)
            Update(minV + (maxV - minV) * (rx / TBG.AbsoluteSize.X))
        end
    end)
    TBG.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            local rx = math.clamp(i.Position.X - TBG.AbsolutePosition.X, 0, TBG.AbsoluteSize.X)
            Update(minV + (maxV - minV) * (rx / TBG.AbsoluteSize.X))
        end
    end)
end

