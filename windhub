-- Cari remote events Fish It
local function findRemote(name)
    -- cari di ReplicatedStorage
    local r = ReplicatedStorage:FindFirstChild(name, true)
    if r then return r end
    -- cari di workspace
    r = workspace:FindFirstChild(name, true)
    if r then return r end
    return nil
end

-- Deteksi GUI fishing (bar, shake, dll)
local function getPlayerGui()
    return LP:FindFirstChild("PlayerGui")
end

local function findFishingGui()
    local pg = getPlayerGui()
    if not pg then return nil end
    -- Cari semua frame yang berhubungan fishing
    for _, gui in pairs(pg:GetDescendants()) do
        local name = string.lower(gui.Name)
        if string.find(name, "fish") or string.find(name, "reel") or
           string.find(name, "catch") or string.find(name, "bar") or
           string.find(name, "shake") or string.find(name, "mini") then
            if gui:IsA("Frame") or gui:IsA("ScreenGui") then
                return gui
            end
        end
    end
    return nil
end

-- Deteksi apakah sedang ada minigame fishing
local function isFishingActive()
    local pg = getPlayerGui()
    if not pg then return false end
    for _, obj in pairs(pg:GetDescendants()) do
        local name = string.lower(obj.Name)
        if obj.Visible == true and (
            string.find(name, "reel") or
            string.find(name, "catch") or
            string.find(name, "shake") or
            string.find(name, "minigame") or
            string.find(name, "fishing")
        ) then
            return true
        end
    end
    return false
end

-- Cari tool fishing di karakter
local function getFishingTool()
    for _, tool in pairs(Char:GetChildren()) do
        if tool:IsA("Tool") then
            local name = string.lower(tool.Name)
            if string.find(name, "rod") or string.find(name, "fish") or
               string.find(name, "reel") or string.find(name, "pole") then
                return tool
            end
        end
    end
    -- Cek backpack juga
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") then
                local name = string.lower(tool.Name)
                if string.find(name, "rod") or string.find(name, "fish") or
                   string.find(name, "reel") or string.find(name, "pole") then
                    return tool
                end
            end
        end
    end
    return nil
end

-- Equip tool
local function equipTool(tool)
    if not tool then return end
    LP.Character.Humanoid:EquipTool(tool)
    task.wait(0.3)
end

-- Simulasi klik mouse (cast/reel)
local function clickMouse()
    Mouse.Button1Down:Fire()
    task.wait(0.05)
    Mouse.Button1Up:Fire()
end

-- Cari NPC Sell terdekat
local function findSellNPC()
    for _, obj in pairs(workspace:GetDescendants()) do
        local name = string.lower(obj.Name)
        if string.find(name, "sell") or string.find(name, "shop") or
           string.find(name, "merchant") or string.find(name, "trader") or
           string.find(name, "npc") then
            if obj:IsA("Model") or obj:IsA("NPC") or obj:IsA("BasePart") then
                return obj
            end
        end
    end
    return nil
end

-- Coba fire semua remote yang berhubungan sell
local function tryAutoSell()
    -- Method 1: cari remote sell
    local remotes = {
        "Sell", "SellFish", "SellAll", "SellItem",
        "sell", "sellfish", "sellall"
    }
    for _, name in pairs(remotes) do
        local r = findRemote(name)
        if r and r:IsA("RemoteEvent") then
            r:FireServer()
            task.wait(S.SellDelay)
        elseif r and r:IsA("RemoteFunction") then
            pcall(function() r:InvokeServer() end)
            task.wait(S.SellDelay)
        end
    end

    -- Method 2: cari tombol sell di GUI
    local pg = getPlayerGui()
    if pg then
        for _, obj in pairs(pg:GetDescendants()) do
            local name = string.lower(obj.Name)
            if obj:IsA("TextButton") and (
                string.find(name, "sell") or
                string.find(obj.Text and string.lower(obj.Text) or "", "sell")
            ) then
                pcall(function()
                    obj.MouseButton1Click:Fire()
                end)
                task.wait(S.SellDelay)
            end
        end
    end
end

-- ── MAIN AUTO FISH LOOP ──
local fishLoop = false
local fishStats = {casts = 0, catches = 0, sold = 0}

local function StartAutoFish()
    fishLoop = true
    task.spawn(function()
        while fishLoop and S.AutoFish do
            local ok, err = pcall(function()

                task.wait(0.15) -- guard minimum agar tidak crash

                -- Step 1: Pastikan rod equipped
                local tool = getFishingTool()
                if tool and not Char:FindFirstChild(tool.Name) then
                    equipTool(tool)
                    task.wait(0.5)
                end

                -- Step 2: Cast
                if S.AutoCast and fishLoop then
                    clickMouse()
                    fishStats.casts += 1
                    task.wait(math.max(S.CastDelay, 0.1))
                end

                -- Step 3: Tunggu minigame muncul (max 15 detik)
                local waited = 0
                while fishLoop and waited < 15 and not isFishingActive() do
                    task.wait(0.25)
                    waited += 0.25
                end

                -- Step 4: Reel / shake
                if fishLoop and isFishingActive() then
                    local reelTime = 0
                    while fishLoop and isFishingActive() and reelTime < 20 do
                        if S.AutoReel or S.AutoShake then
                            clickMouse()
                        end
                        local d = math.max(S.ReelDelay, 0.08)
                        task.wait(d)
                        reelTime += d
                    end
                    fishStats.catches += 1
                end

                task.wait(0.5)

                -- Step 5: Auto sell
                if S.AutoSell and fishLoop then
                    tryAutoSell()
                    fishStats.sold += 1
                    task.wait(math.max(S.SellDelay, 0.3))
                end

                task.wait(0.3)
            end)

            if not ok then
                -- Error → tunggu sebelum retry
                warn("[FishHub] Error: " .. tostring(err))
                task.wait(2)
            end
        end
    end)
end

local function StopAutoFish()
    fishLoop = false
end

