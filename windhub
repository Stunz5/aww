-- ─────────────────────────────────
--   PHYSICS
-- ─────────────────────────────────
local function ApplyPhysics()
    if not Hum then return end
    Hum.WalkSpeed = S.WalkSpeed
    Hum.JumpPower = S.JumpPower
    workspace.Gravity = S.Gravity
    for _, p in pairs(Char:GetDescendants()) do
        if p:IsA("BasePart") then
            local fr = S.AntiSlip and S.FrictionMult or 0.3
            local fw = S.AntiSlip and 1.0 or 0.0
            p.CustomPhysicalProperties = PhysicalProperties.new(0.7, fr, 0.0, fw, 0.0)
        end
    end
end

-- ─────────────────────────────────────────────────────
--   INVISIBLE
--   Cara kerja:
--   Roblox FilteringEnabled = perubahan LocalTransparency
--   tidak sync ke server. Tapi kita bisa pakai method
--   yang mengubah LocalTransparencyModifier di setiap
--   BasePart karakter — ini membuat karakter transparan
--   HANYA di layar kita sendiri (client).
--
--   Untuk membuat ORANG LAIN tidak melihat kita,
--   kita gunakan metode "FakeDelete" — kita pindahkan
--   karakter kita ke posisi yang sangat jauh di atas,
--   taruh HumanoidRootPart di posisi asli pakai
--   invisible anchor, sementara karakter visual
--   disembunyikan dari client semua orang via
--   LocalTransparencyModifier.
--
--   METODE TERBAIK YANG BISA DILAKUKAN CLIENT-SIDE:
--   Set LocalTransparencyModifier = 1 untuk semua parts.
--   Ini membuat karakter tidak terlihat di layar KITA
--   dan juga di layar orang lain JIKA server tidak
--   override (banyak game tidak override ini).
--   Namun di game dengan anti-cheat ketat, ini hanya
--   invisible di layar sendiri.
-- ─────────────────────────────────────────────────────
local invisConn
local originalTransparency = {}

local function SetInvisible(state)
    if not Char then return end

    if state then
        -- Simpan transparency asli & set ke invisible
        for _, p in pairs(Char:GetDescendants()) do
            if p:IsA("BasePart") then
                originalTransparency[p] = p.LocalTransparencyModifier
                p.LocalTransparencyModifier = 1
            elseif p:IsA("Decal") or p:IsA("SpecialMesh") or p:IsA("Texture") then
                -- sembunyikan decal/texture juga
                if p:IsA("Decal") then
                    originalTransparency[p] = p.Transparency
                    p.Transparency = 1
                end
            end
        end

        -- Sembunyikan nama/health bar
        if Hum then
            Hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            Hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        end

        -- Loop terus-menerus agar tetap invisible walau ada perubahan
        invisConn = RunService.Heartbeat:Connect(function()
            if not S.Invisible then return end
            for _, p in pairs(Char:GetDescendants()) do
                if p:IsA("BasePart") then
                    if p.LocalTransparencyModifier ~= 1 then
                        p.LocalTransparencyModifier = 1
                    end
                end
            end
        end)

    else
        -- Kembalikan ke normal
        if invisConn then invisConn:Disconnect(); invisConn = nil end

        for _, p in pairs(Char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.LocalTransparencyModifier = originalTransparency[p] or 0
            elseif p:IsA("Decal") then
                p.Transparency = originalTransparency[p] or 0
            end
        end
        originalTransparency = {}

        -- Kembalikan nama/health bar
        if Hum then
            Hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Automatic
            Hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged
        end
    end
end

-- ─────────────────────────────────────────────────────
--   CHECKPOINT TELEPORT
--   Sistem pencarian checkpoint otomatis:
--   1. Cari objek bernama "Checkpoint", "Stage", "Part",
--      "Spawn", "CheckPoint", "cp", dll di workspace
--   2. Sort berdasarkan posisi Y (ketinggian) atau
--      nama yang mengandung angka
--   3. Tampilkan sebagai list tombol di menu
-- ─────────────────────────────────────────────────────

-- Kata kunci nama checkpoint yang umum dipakai game gunung
local CP_KEYWORDS = {
    "checkpoint", "stage", "cp", "spawn", "level",
    "waypoint", "flag", "finish", "start", "gate",
    "platform", "mount", "peak", "summit", "base",
    "point", "node", "marker", "zone"
}

local function isCheckpoint(obj)
    if not obj:IsA("BasePart") and not obj:IsA("Model") and
       not obj:IsA("SpawnLocation") then return false end
    local name = string.lower(obj.Name)
    for _, kw in pairs(CP_KEYWORDS) do
        if string.find(name, kw) then return true end
    end
    -- Cek juga jika nama mengandung angka (Stage1, CP2, dll)
    if string.match(name, "%d+") and #name < 20 then
        return true
    end
    return false
end

local function getPosition(obj)
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") then
        local root = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if root then return root.Position end
    elseif obj:IsA("SpawnLocation") then
        return obj.Position
    end
    return nil
end

local function ScanCheckpoints()
    local found = {}
    local seen = {}

    local function scan(parent, depth)
        if depth > 6 then return end
        for _, obj in pairs(parent:GetChildren()) do
            if not seen[obj] and isCheckpoint(obj) then
                local pos = getPosition(obj)
                if pos then
                    seen[obj] = true
                    table.insert(found, {
                        name = obj.Name,
                        pos  = pos,
                        obj  = obj
                    })
                end
            end
            scan(obj, depth + 1)
        end
    end

    scan(workspace, 0)

    -- Juga cek SpawnLocation khusus
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") and not seen[obj] then
            seen[obj] = true
            table.insert(found, {
                name = obj.Name,
                pos  = obj.Position,
                obj  = obj
            })
        end
    end

    -- Sort: utamakan nama dengan angka (urut numerik), lalu Y position
    table.sort(found, function(a, b)
        local na = tonumber(string.match(a.name, "%d+") or "")
        local nb = tonumber(string.match(b.name, "%d+") or "")
        if na and nb then return na < nb end
        if na then return true end
        if nb then return false end
        return a.pos.Y < b.pos.Y
    end)

    return found
end

local function TeleportTo(pos)
    if not Root then return end
    -- Teleport sedikit di atas posisi checkpoint agar tidak stuck
    Root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
end

-- ─────────────────────────────────
--   DOUBLE JUMP
-- ─────────────────────────────────
local canDJ, hasDJ = false, false
local djConn

local function SetupDoubleJump()
    if djConn then djConn:Disconnect(); djConn = nil end
    if not S.DoubleJump then return end
    djConn = Hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
            canDJ = true; hasDJ = false
        elseif new == Enum.HumanoidStateType.Freefall then
            task.delay(0.12, function() canDJ = true end)
        end
    end)
end

UserInputService.JumpRequest:Connect(function()
    if not Hum then return end
    if S.InfiniteJump then
        Hum:ChangeState(Enum.HumanoidStateType.Jumping); return
    end
    if S.DoubleJump and canDJ and not hasDJ
       and Hum:GetState() == Enum.HumanoidStateType.Freefall then
        hasDJ = true; canDJ = false
        Root.Velocity = Vector3.new(Root.Velocity.X, S.JumpPower * 0.85, Root.Velocity.Z)
        Hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- ─────────────────────────────────
--   NO CLIP
-- ─────────────────────────────────
local ncConn
local function SetupNoClip()
    if ncConn then ncConn:Disconnect(); ncConn = nil end
    if S.NoClip then
        ncConn = RunService.Stepped:Connect(function()
            for _, p in pairs(Char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    else
        for _, p in pairs(Char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end
end

-- ─────────────────────────────────
--   AUTO JUMP
-- ─────────────────────────────────
local function SetupAutoJump()
    if Hum then Hum.AutoJumpEnabled = S.AutoJump end
end

-- ─────────────────────────────────
--   HEARTBEAT LOOP
-- ─────────────────────────────────
RunService.Heartbeat:Connect(function()
    if not Char or not Root or not Hum then return end

    if S.AntiJatuh and Root.Velocity.Y < -40 then
        Root.Velocity = Vector3.new(Root.Velocity.X, -40, Root.Velocity.Z)
    end

    if S.AutoStabilize then
        local onGround = Hum.FloorMaterial ~= Enum.Material.Air
        local moving = UserInputService:IsKeyDown(Enum.KeyCode.W) or
                       UserInputService:IsKeyDown(Enum.KeyCode.A) or
                       UserInputService:IsKeyDown(Enum.KeyCode.S) or
                       UserInputService:IsKeyDown(Enum.KeyCode.D)
        if onGround and not moving and Root.Velocity.Magnitude > 0.5 then
            Root.Velocity = Vector3.new(Root.Velocity.X * 0.8, Root.Velocity.Y, Root.Velocity.Z * 0.8)
        end
    end

    if S.SpeedBoost then
        local sprint = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        Hum.WalkSpeed = sprint and S.BoostSpeed or S.WalkSpeed
    end

    if S.LowGrav then
        workspace.Gravity = 60
    elseif not S.LowGrav and workspace.Gravity == 60 then
        workspace.Gravity = S.Gravity
    end

    if S.AntiRagdoll then
        if Hum:GetState() == Enum.HumanoidStateType.FallingDown then
            Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    if not S.SpeedBoost and Hum.WalkSpeed ~= S.WalkSpeed then
        Hum.WalkSpeed = S.WalkSpeed
    end
    if Hum.JumpPower ~= S.JumpPower then
        Hum.JumpPower = S.JumpPower
    end
    if not S.LowGrav and workspace.Gravity ~= S.Gravity then
        workspace.Gravity = S.Gravity
    end
end)

-- Respawn
LP.CharacterAdded:Connect(function(c)
    Char = c
    Hum  = c:WaitForChild("Humanoid")
    Root = c:WaitForChild("HumanoidRootPart")
    originalTransparency = {}
    task.wait(0.5)
    ApplyPhysics()
    SetupDoubleJump()
    SetupNoClip()
    SetupAutoJump()
    if S.Invisible then SetInvisible(true) end
end)

