--         TOGGLE WINDOW OPEN/CLOSE
-- ═══════════════════════════════════════════
local isOpen = false

local function OpenWindow()
    isOpen = true
    Win.Visible = true
    Win.Size = UDim2.new(0, 340, 0, 0)
    Win.BackgroundTransparency = 1
    Tween(Win, {Size = UDim2.new(0, 340, 0, 560), BackgroundTransparency = 0}, TI.medium)
    Tween(TopBar, {BackgroundColor3 = C.Accent})
end

local function CloseWindow()
    isOpen = false
    Tween(Win, {Size = UDim2.new(0, 340, 0, 0), BackgroundTransparency = 1}, TI.medium)
    Tween(TopBar, {BackgroundColor3 = C.Surface})
    task.delay(0.3, function()
        if not isOpen then Win.Visible = false end
    end)
end

TopBtn.MouseButton1Click:Connect(function()
    if isOpen then CloseWindow() else OpenWindow() end
end)

CloseBtn.MouseButton1Click:Connect(CloseWindow)

-- Keyboard shortcut [K]
UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == Enum.KeyCode.K then
        if isOpen then CloseWindow() else OpenWindow() end
    end
end)

-- ─── DRAG WINDOW ───
local dragStart2, startPos2, dragActive = nil, nil, false

TitleBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragActive = true
        dragStart2 = i.Position
        startPos2  = Win.Position
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragActive = false end
end)
UserInputService.InputChanged:Connect(function(i)
    if dragActive and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dragStart2
        Win.Position = UDim2.new(startPos2.X.Scale, startPos2.X.Offset + d.X, startPos2.Y.Scale, startPos2.Y.Offset + d.Y)
    end
end)

