-- ─────────────────────────────────────────
--            DOUBLE JUMP LOGIC
-- ─────────────────────────────────────────
local canDoubleJump  = false
local hasDoubleJumped = false
local jumpConn, djConn

local function SetupDoubleJump()
    if djConn then djConn:Disconnect(); djConn = nil end

    if S.DoubleJump then
        -- Deteksi saat landed untuk reset
        djConn = Hum.StateChanged:Connect(function(old, new)
            if new == Enum.HumanoidStateType.Landed or
               new == Enum.HumanoidStateType.Running then
                canDoubleJump    = true
                hasDoubleJumped  = false
            elseif new == Enum.HumanoidStateType.Freefall then
                task.delay(0.15, function()
                    canDoubleJump = true
                end)
            end
        end)
    end
end

-- Input untuk double jump & infinite jump
UserInputService.JumpRequest:Connect(function()
    if not Char or not Hum then return end

    if S.InfiniteJump then
        Hum:ChangeState(Enum.HumanoidStateType.Jumping)
        return
    end

    if S.DoubleJump and canDoubleJump and not hasDoubleJumped
       and Hum:GetState() == Enum.HumanoidStateType.Freefall then
        hasDoubleJumped = true
        canDoubleJump   = false
        -- Lompatan kedua
        Root.Velocity = Vector3.new(
            Root.Velocity.X,
            S.JumpPower * 0.85,
            Root.Velocity.Z
        )
        Hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- ─────────────────────────────────────────
--            PHYSICS CORE
-- ─────────────────────────────────────────
local function ApplyPhysics()
    if not Char or not Hum then return end
    Hum.WalkSpeed  = S.WalkSpeed
    Hum.JumpPower  = S.JumpPower
    workspace.Gravity = S.Gravity

    for _, p in pairs(Char:GetDescendants()) do
        if p:IsA("BasePart") then
            local fr = S.AntiSlip and S.FrictionMult or 0.3
            p.CustomPhysicalProperties = PhysicalProperties.new(0.7, fr, 0.0, S.AntiSlip and 1.0 or 0.0, 0.0)
        end
    end
end

-- Anti Jatuh – cap fall speed
RunService.Heartbeat:Connect(function()
    if not Char or not Root or not Hum then return end

    -- Anti Jatuh
    if S.AntiJatuh then
        local vy = Root.Velocity.Y
        if vy < -38 then
            Root.Velocity = Vector3.new(Root.Velocity.X, -38, Root.Velocity.Z)
        end
    end

    -- Auto Stabilize (stop sliding on slope)
    if S.AutoStabilize then
        local isGround = Hum.FloorMaterial ~= Enum.Material.Air
        local moving   = (UserInputService:IsKeyDown(Enum.KeyCode.W) or
                          UserInputService:IsKeyDown(Enum.KeyCode.A) or
                          UserInputService:IsKeyDown(Enum.KeyCode.S) or
                          UserInputService:IsKeyDown(Enum.KeyCode.D))
        if isGround and not moving then
            local v = Root.Velocity
            if v.Magnitude > 0.5 then
                Root.Velocity = Vector3.new(v.X * 0.82, v.Y, v.Z * 0.82)
            end
        end
    end

    -- Speed Boost (hold shift)
    if S.SpeedBoost then
        local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
        Hum.WalkSpeed = shift and S.BoostSpeed or S.WalkSpeed
    end

    -- Sync speed/jump
    if Hum.WalkSpeed ~= S.WalkSpeed and not S.SpeedBoost then
        Hum.WalkSpeed = S.WalkSpeed
    end
    if Hum.JumpPower ~= S.JumpPower then
        Hum.JumpPower = S.JumpPower
    end
    if workspace.Gravity ~= S.Gravity then
        workspace.Gravity = S.Gravity
    end
end)

-- No Clip
local ncConn
local function SetupNoClip()
    if ncConn then ncConn:Disconnect(); ncConn = nil end
    if S.NoClip then
        ncConn = RunService.Stepped:Connect(function()
            for _, p in pairs(Char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
    else
        for _, p in pairs(Char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end
end

