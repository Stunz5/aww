    ILbl.Position = UDim2.new(0, 12, 0, 0)
    ILbl.BackgroundTransparency = 1
    ILbl.Text = icon or ""
    ILbl.TextScaled = true
    ILbl.Parent = Row
    Pad(ILbl, 9,9,0,0)

    local Lbl = Instance.new("TextLabel")
    Lbl.Size = UDim2.new(1, -50, 1, 0)
    Lbl.Position = UDim2.new(0, 40, 0, 0)
    Lbl.BackgroundTransparency = 1
    Lbl.Text = label
    Lbl.TextSize = 13
    Lbl.Font = Enum.Font.GothamBold
    Lbl.TextColor3 = C.Text
    Lbl.TextXAlignment = Enum.TextXAlignment.Left
    Lbl.Parent = Row

    Row.MouseEnter:Connect(function()
        Tween(Row, {BackgroundColor3 = Color3.fromRGB(
            math.clamp((color or C.SurfaceAlt).R * 255 + 12, 0, 255),
            math.clamp((color or C.SurfaceAlt).G * 255 + 12, 0, 255),
            math.clamp((color or C.SurfaceAlt).B * 255 + 12, 0, 255)
        )})
    end)
    Row.MouseLeave:Connect(function() Tween(Row, {BackgroundColor3 = color or C.SurfaceAlt}) end)
    Row.MouseButton1Click:Connect(function()
        Tween(Row, {BackgroundColor3 = C.Accent})
        task.delay(0.15, function() Tween(Row, {BackgroundColor3 = color or C.SurfaceAlt}) end)
        if callback then callback() end
    end)

    return Row
end

