local isOpen = false

local function Open()
    isOpen = true
    Win.Visible = true
    Win.Size = UDim2.new(0, 300, 0, 0)
    tw(Win, {Size = UDim2.new(0, 300, 0, 540)}, 0.22)
    tw(Pill, {BackgroundColor3 = COLOR.Accent, TextColor3 = COLOR.White})
end

local function Close()
    isOpen = false
    tw(Win, {Size = UDim2.new(0, 300, 0, 0)}, 0.18)
    tw(Pill, {BackgroundColor3 = COLOR.Panel, TextColor3 = COLOR.Accent})
    task.delay(0.2, function() if not isOpen then Win.Visible = false end end)
end

Pill.MouseButton1Click:Connect(function() if isOpen then Close() else Open() end end)
HClose.MouseButton1Click:Connect(Close)

